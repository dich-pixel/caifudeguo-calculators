{
  "name": "caifudeguo-calculators",
  "type": "module",
  "version": "1.4.3",
  "packageManager": "pnpm@10.30.3",
  "description": "Modified version of finanzfluss/calculators (AGPL-3.0) used for the calculators on caifudeguo.de. Not affiliated with Finanzfluss.",
  "author": "Finflow GmbH",
  "contributors": [
    "Rich Dr (caifudeguo.de)"
  ],
  "license": "AGPL-3.0",
  "homepage": "https://github.com/dich-pixel/caifudeguo-calculators#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dich-pixel/caifudeguo-calculators.git"
  },
  "bugs": {
    "url": "https://github.com/dich-pixel/caifudeguo-calculators/issues"
  },
  "keywords": [
    "calculator",
    "caifudeguo"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "default": "./dist/utils/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{css,html,json,js,md,ts,yml}\" --write",
    "format:check": "prettier \"**/*.{css,html,json,js,md,ts,yml}\" --check",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:types": "tsc --noEmit",
    "release": "bumpp",
    "check:core": "node caifudeguo/check-core.mjs",
    "av:build": "vite build --config caifudeguo/av-ui/vite.config.mjs",
    "av:dev": "vite --config caifudeguo/av-ui/vite.config.mjs",
    "wp:zip": "node caifudeguo/wp-plugin/build-zip.mjs",
    "bvr:dev": "vite --config caifudeguo/buy-vs-rent/vite.config.mjs",
    "bvr:build": "vite build --config caifudeguo/buy-vs-rent/vite.config.mjs",
    "bvr:test": "vitest run --config caifudeguo/buy-vs-rent/vitest.config.ts",
    "bvr:preview": "vite preview --config caifudeguo/buy-vs-rent/vite.config.mjs",
    "bvr:zip": "node caifudeguo/buy-vs-rent/scripts/build-zip.mjs",
    "bvr:e2e": "playwright test --config caifudeguo/buy-vs-rent/playwright.config.ts",
    "bvr:php-test": "php caifudeguo/buy-vs-rent/plugin/tests/sanitize-defaults.test.php && php caifudeguo/buy-vs-rent/plugin/tests/rocket-exclusions.test.php"
  },
  "peerDependencies": {
    "@formulajs/formulajs": "^4.5.3",
    "bignumber.js": "^9.3.1",
    "dinero.js": "^2.0.2",
    "zod": "^4.1.5"
  },
  "dependencies": {
    "chart.js": "^4.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.6.1",
    "@vitest/coverage-v8": "4.0.1",
    "@vitest/ui": "4.0.1",
    "bumpp": "^10.4.1",
    "eslint": "^10.0.2",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "prettier": "^3.8.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "ufo": "^1.6.3",
    "vite": "7.3.1",
    "vitest": "^4.0.18"
  }
}
